# ─── LukeAI Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your own values.
# NEVER commit .env to git — it is in .gitignore.

# ─── Firebase (required) ─────────────────────────────────────────────────────
# Get these from https://console.firebase.google.com → Project Settings → Your apps
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXX

# ─── Anthropic Claude API (optional — users can also enter their own key) ────
# If set here, all users share this key (useful for demo; not recommended for prod)
# Better: leave blank and let each user provide their own key in Settings
VITE_ANTHROPIC_API_KEY=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

# ─── Gemini (AI image generation, optional) ──────────────────────────────────
# Get a key at https://aistudio.google.com/apikey — needed for [GENERATE_IMAGE: ...]
# to work. Without it, real image generation is skipped (search-based [IMAGE: ...]
# still works via the Google Custom Search keys below).
VITE_GEMINI_API_KEY=

# ─── App ─────────────────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:3000

# ─── Development ─────────────────────────────────────────────────────────────
# Set to true to use local Firebase emulators instead of production
VITE_USE_FIREBASE_EMULATOR=false
