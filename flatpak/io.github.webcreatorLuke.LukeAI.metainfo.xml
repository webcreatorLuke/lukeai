    <content_attribute id="social-chat">mild</content_attribute>
  </content_rating>

  <releases>
    <release version="1.0.0" date="2026-09-06">
      <description>
        <p>Initial release.</p>
      </description>
    </release>
  </releases>

  <categories>
    <category>Network</category>
    <category>Chat</category>
    <category>Utility</category>
  </categories>

  <branding>
    <color type="primary" scheme_preference="light">#a855f7</color>
    <color type="primary" scheme_preference="dark">#6d28d9</color>
  </branding>
</component>
