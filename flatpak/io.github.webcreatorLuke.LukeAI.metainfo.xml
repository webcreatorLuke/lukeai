<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.webcreatorLuke.LukeAI</id>
  <name>LukeAI</name>
  <summary>Chat with Claude, with image generation and file downloads</summary>

  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>

  <description>
    <p>
      LukeAI is a desktop chat client for Anthropic's Claude models. It supports
      real-time streaming responses, AI image generation, downloadable file
      output, and Google sign-in.
    </p>
    <p>
      You'll need your own Anthropic API key (available from
      console.anthropic.com) to use the app — enter it once in Settings.
    </p>
  </description>

  <launchable type="desktop-id">io.github.webcreatorLuke.LukeAI.desktop</launchable>

  <url type="homepage">https://github.com/webcreatorLuke/lukeai</url>
  <url type="vcs-browser">https://github.com/webcreatorLuke/lukeai</url>
  <url type="bugtracker">https://github.com/webcreatorLuke/lukeai/issues</url>

  <!-- TODO: replace with a real hosted screenshot (1-3 recommended).
