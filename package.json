{
  "name": "lukeai",
  "version": "1.0.0",
  "private": true,
  "description": "LukeAI — Personal AI assistant powered by Claude, with Firebase authentication",
  "author": "Luke",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write src/**/*.{js,jsx,ts,tsx,css}",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "deploy": "vite build && firebase deploy",
    "build:electron": "vite build --outDir dist-electron --base /",
    "electron": "electron .",
    "electron:dev": "npm run build:electron && electron .",
    "dist:flatpak": "npm run build:electron && electron-builder --linux flatpak"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "firebase": "^10.13.0",
    "@anthropic-ai/sdk": "^0.26.0",
    "zustand": "^4.5.4",
    "framer-motion": "^11.3.19",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "rehype-highlight": "^7.0.0",
    "highlight.js": "^11.10.0",
    "react-syntax-highlighter": "^15.5.0",
    "lucide-react": "^0.439.0",
    "date-fns": "^3.6.0",
    "uuid": "^10.0.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.2",
    "react-hot-toast": "^2.4.1",
    "react-textarea-autosize": "^8.5.4",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "react-hook-form": "^7.53.0",
    "@hookform/resolvers": "^3.9.0",
    "zod": "^3.23.8",
    "axios": "^1.7.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.3.3",
    "vite": "^5.4.2",
    "vitest": "^2.0.5",
    "firebase-tools": "^13.16.0",
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.github.webcreatorLuke.LukeAI",
    "productName": "LukeAI",
    "files": [
      "electron/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target":   ["flatpak"],
      "category": "Utility",
      "icon":     "build-resources/icon.png"
    },
    "flatpak": {
      "runtimeVersion": "23.08",
      "finishArgs": [
        "--share=network",
        "--socket=x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--device=dri"
      ]
    }
  }
}
